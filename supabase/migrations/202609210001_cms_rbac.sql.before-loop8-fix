create policy if not exists "Public can read published gallery only"
  on public.gallery_items for select
  using (is_published = true or public.is_super_admin() or public.has_permission('gallery.view'));

create policy if not exists "Admins can insert gallery"
  on public.gallery_items for insert
  with check (public.is_super_admin() or public.has_permission('gallery.create'));

create policy if not exists "Admins can update gallery"
  on public.gallery_items for update
  using (public.is_super_admin() or public.has_permission('gallery.update'))
  with check (public.is_super_admin() or public.has_permission('gallery.update'));

create policy if not exists "Admins can delete gallery"
  on public.gallery_items for delete
  using (public.is_super_admin() or public.has_permission('gallery.delete'));

create or replace function public.log_audit_event(
  p_action text,
  p_entity_type text,
  p_entity_id uuid,
  p_details jsonb default '{}'::jsonb
)
returns void
language sql
security definer
set search_path = public
as $$
  insert into public.audit_logs (actor_id, actor_role, action, entity_type, entity_id, details)
  values (
    auth.uid(),
    coalesce((select ar.role_name from public.admin_users au join public.admin_roles ar on ar.id = au.role_id where au.user_id = auth.uid() limit 1), 'public'),
    p_action,
    p_entity_type,
    p_entity_id,
    p_details
  );
$$;

comment on function public.is_super_admin is 'Returns true when the current authenticated user is a system super admin.';
comment on function public.has_permission is 'Checks whether the current user has a specific admin permission.';
comment on function public.current_admin_user is 'Returns the active admin user record for the current authenticated user.';

